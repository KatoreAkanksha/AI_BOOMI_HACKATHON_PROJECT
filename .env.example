# ⚠️ REPLACE ALL PLACEHOLDER VALUES BEFORE RUNNING

# ==============================================
# GOOGLE OAUTH CONFIGURATION
# ==============================================
# Get from: https://console.cloud.google.com/
# Navigate to: APIs & Services → Credentials
# Create: OAuth 2.0 Client ID (Web application)
# Authorized origins: http://localhost:5173, http://localhost:3000
VITE_GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com

# ==============================================
# FACEBOOK OAUTH CONFIGURATION
# ==============================================
# Get from: https://developers.facebook.com/apps/
# Create App → Consumer type
# Settings → Basic → Copy App ID
# IMPORTANT: Switch app to "Live" mode!
VITE_FACEBOOK_APP_ID=1234567890123456

# ==============================================
# API ENDPOINTS (Development)
# ==============================================
VITE_API_URL=http://localhost:5001
VITE_ASSESSMENT_API_URL=http://localhost:5002

# ==============================================
# INSTRUCTIONS:
# ==============================================
# 1. Copy this file to `.env` in the same directory
# 2. Replace all placeholder values with your real credentials
# 3. Restart the dev server: npm run dev
# 4. Never commit the real `.env` file to git
